# Copy to config/.env or set PAI_ENV_FILE to a private env file path.
# Do not commit real credentials.

STAGING_DB_HOST="your-staging-host.example.com"
STAGING_DB_PORT=3306
STAGING_DB_NAME="staging"
STAGING_DB_USER="your_staging_user"
STAGING_DB_PASSWORD="replace-me"

MYSQL_USER="${STAGING_DB_USER}"
MYSQL_PASSWORD="${STAGING_DB_PASSWORD}"
MYSQL_STAGING_HOST="${STAGING_DB_HOST}"
MYSQL_STAGING_DB="${STAGING_DB_NAME}"

# Optional warehouse target used by Spark/JDBC load steps.
DW_DB_HOST="your-warehouse-host.example.com"
DW_DB_PORT=3306
DW_DB_NAME="warehouse"
DW_DB_USER="your_warehouse_user"
DW_DB_PASSWORD="replace-me"

# Optional legacy aliases used by the notebook-exported sensor script.
DW_HOST="${DW_DB_HOST}"
DW_PORT="${DW_DB_PORT}"
DW_DB="${DW_DB_NAME}"
DW_USER="${DW_DB_USER}"
DW_PASS="${DW_DB_PASSWORD}"
DW_TABLE="Dim_Sensor"

# Optional safety fact load URI. Example only; keep the real value private.
DW_URI="mysql+pymysql://user:password@host:3306/warehouse"
DW_DATABASE="warehouse"

# Optional local MySQL JDBC jar path for Spark.
PAI_MYSQL_JDBC_JAR="vendor/mysql-connector-j-8.0.33.jar"
